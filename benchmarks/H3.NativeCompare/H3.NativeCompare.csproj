<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Apples-to-apples: this is the H3.NET.Native repo's OWN benchmark
    (tests/H3.NET.Native.Benchmarks, the harness they publish when they cite
    pocketken.H3), copied verbatim. Only the wiring is swapped:
      * "pocketken" side  -> this working tree's src/H3 (ProjectReference),
        instead of the published pocketken.H3 4.0.0 package they measured;
      * native binding     -> the H3.NET.Native NuGet package (bench/validation
        only, never shipped);
      * raw libh3          -> [LibraryImport("h3")] resolving the package's
        runtimes/linux-x64/native/libh3.so (RID-scoped copy).
    Same operations, same inputs, same BDN config (full job, MemoryDiagnoser,
    grouped by category) as their published numbers.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageReference Include="H3.NET.Native" Version="*" />
    <PackageReference Include="NetTopologySuite" Version="2.6.0" />
    <ProjectReference Include="../../src/H3/H3.csproj" />
  </ItemGroup>

</Project>
